# Supabase project credentials (Project Settings -> API).
# Own project for this app — do not point this at the Eco Air Sense Supabase project
# (see docs/architecture.md §2).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings -> API) — server-only. Used by the Stripe webhook
# handler and the daily replacement-schedule recalculation job to write past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys while in development). No publishable key needed — checkout
# redirects the browser straight to Stripe's hosted session.url, no Stripe.js on the client.
STRIPE_SECRET_KEY=
# Real signing secret from Stripe Dashboard -> Developers -> Webhooks once an endpoint is
# configured there; for pure local dev without the Stripe CLI/a tunnel, any string works as
# long as it matches whatever you use to hand-sign test payloads with the same HMAC scheme.
STRIPE_WEBHOOK_SECRET=

# Anthropic API key for the ECT AI assistant (Phase 8). The sibling Eco Air Sense app's
# key may be reusable for MVP; separate billing/rate-limit isolation is a later concern.
ANTHROPIC_API_KEY=

# Resend API key for order confirmation and replacement-due reminder emails.
RESEND_API_KEY=
ORDER_CONFIRMATION_EMAIL_FROM="ECT Marine Store <onboarding@resend.dev>"

# Shared secret required in the Authorization header of cron requests
# (Vercel sends this automatically for jobs defined in vercel.json).
CRON_SECRET=

# Public URL of the deployed app, used in emails and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
